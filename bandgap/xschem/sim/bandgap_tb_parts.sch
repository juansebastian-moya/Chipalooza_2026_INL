C {code_shown.sym} -550 -300 0 0 {name=SPICE only_toplevel=false value=
"
.temp 27
.option method=gear
.param L_VAR = 7.4u
.control
save all

op
echo "BJTs"
print @q.xq0.q0[vbe]
print @q.xq1.q0[vbe]
print @q.xq0.q0[ie]
print @q.xq1.q0[ie]
print v(VB0_BJTs)
print v(VPB_BJTs)
print v(VSET_BJTs)
print v(VBG_BJTs)

echo "Mirrors"
print @m.xm0.m0[id]
print @m.xm1.m0[id]

echo "BGR"
print @q.xq2.q0[vbe]
print @q.xq3.q0[vbe]
print @q.xq2.q0[ie]
print @q.xq3.q0[ie]
print @m.xm2.m0[id]
print @m.xm3.m0[id]
print v(VB0_BGR)
print v(VPB_BGR)
print v(VSET_BGR)
print v(VBG_BGR)

echo "BGRSTART"
print @q.xq4.q0[vbe]
print @q.xq5.q0[vbe]
print @q.xq4.q0[ie]
print @q.xq5.q0[ie]
print @m.xm4.m0[id]
print @m.xm5.m0[id]
print v(VB0_BGRSTART)
print v(VPB_BGRSTART)
print v(VSET_BGRSTART)
print v(VBG_BGRSTART)


*.param L_VAR = 7u
*echo "Corrent_L_7u"
*print @m.xm0.m0[id]
*alterparam L_VAR = 8u
*reset
*op
*echo "Corrent_L_8u"
*print @m.xm0.m0[id]

write bandgap_tb_parts.raw
.endc
"


















}
